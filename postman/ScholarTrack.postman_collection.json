    {
      "name": "3. Verification, Disbursement and Business Rules",
      "item": [
        {
          "name": "Attempt review of ineligible application (expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{ineligibleApplicationId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{ineligibleApplicationId}}",
                "review"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Message is correct', function () { pm.expect(pm.response.json().message).to.include(\"cannot proceed to manual verification\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attempt invalid verification - ineligible application (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "verifications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"applicationId\": {{ineligibleApplicationId}}, \"verifiedBy\": \"Dr. Ramesh Kumar\", \"status\": \"APPROVED\", \"remarks\": \"Should be blocked\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Message is correct', function () { pm.expect(pm.response.json().message).to.include(\"cannot be verified\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attempt verification before review (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/verifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "verifications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"applicationId\": {{applicationId}}, \"verifiedBy\": \"Dr. Ramesh Kumar\", \"status\": \"APPROVED\", \"remarks\": \"Too early\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attempt premature disbursement - not reviewed (expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/disburse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "disburse"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Message is correct', function () { pm.expect(pm.response.json().message).to.include(\"Disbursement cannot be completed until verification is approved.\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Review application (start manual review)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "review"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Under review', function () { pm.expect(pm.response.json().applicationStatus).to.eql('UNDER_REVIEW'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attempt premature disbursement - verification pending (expect 400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
