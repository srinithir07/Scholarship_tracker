            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Eligible Student\",\n  \"email\": \"eligible.{{$timestamp}}@example.com\",\n  \"phone\": \"9876543210\",\n  \"annualIncome\": 200000,\n  \"marks\": 85,\n  \"course\": \"B.E. Computer Science\",\n  \"year\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
